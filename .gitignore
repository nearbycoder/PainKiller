# Dependencies and local tool environments
node_modules/
.art-venv/
__pycache__/
*.pyc

# Build output (attach builds to GitHub Releases instead)
dist/
release/
build/*
!build/icon.png
!build/make-icon.py
.vite/
*.tsbuildinfo

# Local smoke-test profiles, verification output and logs
artifacts/
*.log

# Raw captures; finished media lives in docs/media/
captures/
docs/media/raw/
*.y4m

# Blender masters and downloaded CC0 sources are regenerated by
# tools/fetch-art.py + tools/build-assets.sh (see art/README.md)
*.blend
*.blend1
*.blend@
art/source/
art/renders/
art/textures/

# Downloaded source textures and baked maps; the runtime GLBs embed them
public/assets/textures/*/

# Secrets and machine-local settings
.env
.env.*
*.pem
*.key

# OS and editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
